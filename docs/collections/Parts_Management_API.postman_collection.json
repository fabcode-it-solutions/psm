  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Global pre-request script",
          "// This runs before every request",
          "",
          "// Log current environment",
          "console.log('📍 Base URL:', pm.collectionVariables.get('base_url'));",
          "",
          "// Check if CSRF token exists for state-changing methods",
          "const method = pm.request.method;",
          "if (['POST', 'PUT', 'PATCH', 'DELETE'].includes(method)) {",
          "    const csrf = pm.collectionVariables.get('csrf_token');",
          "    if (!csrf) {",
          "        console.warn('⚠️ No CSRF token found. Requesting will fetch one automatically.');",
          "    } else {",
          "        console.log('✅ CSRF token present');",
          "    }",
          "}"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Global test script",
          "// This runs after every request",
          "",
          "// Log response time",
          "console.log('⏱️ Response time:', pm.response.responseTime + 'ms');",
          "",
          "// Log status code",
          "const statusCode = pm.response.code;",
          "if (statusCode >= 200 && statusCode < 300) {",
          "    console.log('✅ Success:', statusCode);",
          "} else if (statusCode >= 400 && statusCode < 500) {",
          "    console.log('⚠️ Client error:', statusCode);",
          "} else if (statusCode >= 500) {",
          "    console.log('❌ Server error:', statusCode);",
          "}",
          "",
          "// Check for common errors",
          "if (statusCode === 401) {",
          "    console.log('🔐 Unauthorized - You may need to sign in first');",
          "} else if (statusCode === 403) {",
          "    console.log('🚫 Forbidden - Check CSRF token or permissions');",
          "} else if (statusCode === 429) {",
          "    console.log('⏸️ Rate limit exceeded - Wait before retrying');",
          "}"
        ]
      }
    }
  ]
